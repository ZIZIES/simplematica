{
	"schemaVersion": 1,
	"id": "simplematica",
	"name": "Simplematica",
	"version": "${mod_version}",

	"description": "A stripped-down Litematica fork: load a schematic and build it, with a material list for the layer you are actually on.",
	"authors": [
		"ZIZIES"
	],
	"contributors": [
		"masa (original Litematica author)",
		"Sakura-Ryoko (Litematica 26.2 maintainer)"
	],
	"contact": {
		"homepage": "https://github.com/ZIZIES/simplematica",
		"issues": "https://github.com/ZIZIES/simplematica/issues",
		"sources": "https://github.com/ZIZIES/simplematica"
	},

	"license": "LGPLv3",
	"icon": "assets/simplematica/icon.png",

	"environment": "client",
	"entrypoints": {
		"main": [
			"fi.dy.masa.simplematica.Simplematica"
		],
		"modmenu": [
			"fi.dy.masa.simplematica.compat.modmenu.ModMenuImpl"
		]
	},
	"mixins": [
		"mixins.simplematica.json"
	],
    "accessWidener": "simplematica.accesswidener",

	"depends": {
		"minecraft": "~26.2-",
		"malilib": ">=0.29.5- <0.30.0-"
	},
	"breaks": {
		"malilib": "<0.29.5-"
	}
}
